{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/menu", "destination": "/index.html" },
    { "source": "/book", "destination": "/book.html" },
    { "source": "/track", "destination": "/track.html" },
    { "source": "/kds", "destination": "/track.html" },
    { "source": "/EATZY/index.php/component/eatzy", "has": [{ "type": "query", "key": "view", "value": "book" }], "destination": "/book.html" },
    { "source": "/EATZY/index.php/component/eatzy", "has": [{ "type": "query", "key": "view", "value": "track" }], "destination": "/track.html" },
    { "source": "/EATZY/(.*)", "destination": "/index.html" }
  ]
}
